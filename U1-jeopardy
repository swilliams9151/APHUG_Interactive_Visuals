const finalJeopardy = {
  category: "Regional Analysis",
  clue: "A geographer describes an area as having shared language traits, similar cultural traditions, and a strong identity, but different people disagree on its exact boundaries. What type of region is this, and why?",
  answer: "Vernacular region, because it is based on people’s perceptions and shared identity rather than exact official boundaries.",
};

function getCellId(categoryIndex, clueIndex) {
  return `${categoryIndex}-${clueIndex}`;
}

function ScoreControls({ team, onRename, onAdd, onSubtract }) {
  return (
    <Card className="rounded-2xl shadow-sm border-blue-200">
      <CardContent className="p-4 space-y-3">
        <Input
          value={team.name}
          onChange={(e) => onRename(team.id, e.target.value)}
          className="font-semibold"
        />
        <div className="flex items-center justify-between">
          <div className="text-3xl font-bold text-slate-800">{team.score}</div>
          <Badge variant="secondary" className="text-sm">points</Badge>
        </div>
        <div className="flex gap-2">
          <Button size="sm" className="flex-1" onClick={() => onAdd(team.id, 100)}>
            <Plus className="w-4 h-4 mr-1" />100
          </Button>
          <Button size="sm" variant="outline" className="flex-1" onClick={() => onSubtract(team.id, 100)}>
            <Minus className="w-4 h-4 mr-1" />100
          </Button>
        </div>
      </CardContent>
    </Card>
  );
}

export default function AphugUnit1JeopardyWebsite() {
  const [teams, setTeams] = useState(initialTeams);
  const [used, setUsed] = useState({});
  const [selected, setSelected] = useState(null);
  const [showAnswer, setShowAnswer] = useState(false);
  const [mode, setMode] = useState("board");
  const [showSetup, setShowSetup] = useState(true);
  const [dailyDouble, setDailyDouble] = useState({ "2-4": true, "5-3": true });

  const leaderboard = useMemo(
    () => [...teams].sort((a, b) => b.score - a.score),
    [teams]
  );

  const handleRename = (id, name) => {
    setTeams((prev) => prev.map((t) => (t.id === id ? { ...t, name } : t)));
  };

  const handleAdd = (id, amt) => {
    setTeams((prev) => prev.map((t) => (t.id === id ? { ...t, score: t.score + amt } : t)));
  };

  const handleSubtract = (id, amt) => {
    setTeams((prev) => prev.map((t) => (t.id === id ? { ...t, score: t.score - amt } : t)));
  };

  const openClue = (categoryIndex, clueIndex) => {
    const id = getCellId(categoryIndex, clueIndex);
    const category = categories[categoryIndex];
    const clue = category.clues[clueIndex];
    setSelected({ id, category: category.name, clue, categoryIndex, clueIndex, isDailyDouble: !!dailyDouble[id] });
    setShowAnswer(false);
  };

  const markUsed = () => {
    if (!selected) return;
    setUsed((prev) => ({ ...prev, [selected.id]: true }));
  };

  const resetGame = () => {
    setTeams(initialTeams);
    setUsed({});
    setSelected(null);
    setShowAnswer(false);
    setMode("board");
  };

  const allRegularUsed = Object.keys(used).length >= categories.reduce((sum, cat) => sum + cat.clues.length, 0);

  return (
    <div className="min-h-screen bg-slate-100 p-4 md:p-6">
      <div className="max-w-7xl mx-auto space-y-6">
        <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <h1 className="text-3xl md:text-4xl font-bold text-slate-900">{GAME_TITLE}</h1>
            <p className="text-slate-600 mt-1">A JeopardyLabs-style review game for AP Human Geography Unit 1</p>
          </div>
          <div className="flex flex-wrap gap-2">
            <Button variant="outline" onClick={() => setShowSetup((s) => !s)}>
              <MonitorPlay className="w-4 h-4 mr-2" />
              {showSetup ? "Hide Setup" : "Show Setup"}
            </Button>
            <Button variant="outline" onClick={() => setMode(mode === "board" ? "host" : "board")}>
              {mode === "board" ? "Host View" : "Board View"}
            </Button>
            <Button variant="outline" onClick={resetGame}>
              <RotateCcw className="w-4 h-4 mr-2" />Reset Game
            </Button>
          </div>
        </div>

        {showSetup && (
          <div className="grid grid-cols-1 xl:grid-cols-4 gap-4">
            <Card className="xl:col-span-3 rounded-2xl shadow-sm border-blue-200">
              <CardHeader>
                <CardTitle className="text-xl">How to use this on your website</CardTitle>
              </CardHeader>
              <CardContent className="space-y-3 text-sm text-slate-700">
                <p>Rename teams, project the board, click a dollar amount to open a clue, reveal the answer when ready, and adjust scores from the sidebar or host view.</p>
                <p>This version includes Daily Double support, clue tracking, Final Jeopardy, score controls, and a clean classroom presentation mode.</p>
                <div className="flex flex-wrap gap-2 pt-1">
                  <Badge className="bg-blue-700">6 categories</Badge>
                  <Badge className="bg-blue-700">5 clues each</Badge>
                  <Badge className="bg-blue-700">Daily Double</Badge>
                  <Badge className="bg-blue-700">Final Jeopardy</Badge>
                </div>
              </CardContent>
            </Card>
            <Card className="rounded-2xl shadow-sm border-blue-200">
              <CardHeader>
                <CardTitle className="text-xl flex items-center gap-2"><Trophy className="w-5 h-5" />Leaderboard</CardTitle>
              </CardHeader>
              <CardContent className="space-y-2">
                {leaderboard.map((team, idx) => (
                  <div key={team.id} className="flex items-center justify-between rounded-xl bg-slate-50 p-3 border">
                    <div className="font-medium text-slate-800">{idx + 1}. {team.name}</div>
                    <div className="font-bold text-lg text-slate-900">{team.score}</div>
                  </div>
                ))}
              </CardContent>
            </Card>
          </div>
        )}

        <div className="grid grid-cols-1 xl:grid-cols-4 gap-6">
          <div className="xl:col-span-3">
            <Card className="rounded-3xl shadow-md overflow-hidden border-blue-300">
              <CardContent className="p-0">
                <div className="grid grid-cols-6 bg-blue-950 text-white">
                  {categories.map((cat) => (
                    <div key={cat.name} className="border border-blue-700 p-3 min-h-24 flex items-center justify-center text-center font-bold text-sm md:text-base leading-tight">
                      {cat.name}
                    </div>
                  ))}
                </div>
                {[0, 1, 2, 3, 4].map((rowIndex) => (
                  <div key={rowIndex} className="grid grid-cols-6 bg-blue-900">
                    {categories.map((cat, categoryIndex) => {
                      const clue = cat.clues[rowIndex];
                      const id = getCellId(categoryIndex, rowIndex);
                      const isUsed = !!used[id];
                      const isDD = !!dailyDouble[id];
                      return (
                        <button
                          key={id}
                          onClick={() => openClue(categoryIndex, rowIndex)}
                          disabled={isUsed}
                          className={`border border-blue-700 min-h-24 md:min-h-28 p-2 flex items-center justify-center text-center transition-all ${
                            isUsed
                              ? "bg-blue-950 text-blue-950 cursor-not-allowed"
                              : "bg-blue-900 hover:bg-blue-800"
                          }`}
                        >
                          {!isUsed && (
                            <div className="flex flex-col items-center gap-1">
                              {isDD && <Badge className="bg-amber-400 text-slate-900 hover:bg-amber-400">Daily Double</Badge>}
                              <span className="text-yellow-300 font-extrabold text-2xl md:text-4xl drop-shadow-sm">
                                ${clue.value}
                              </span>
                            </div>
                          )}
                        </button>
                      );
                    })}
                  </div>
                ))}
              </CardContent>
            </Card>

            <div className="mt-4 flex flex-wrap gap-2">
              <Button onClick={() => setSelected({ id: "final", category: finalJeopardy.category, clue: finalJeopardy, isFinal: true })} className="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold">
                <Flag className="w-4 h-4 mr-2" />Open Final Jeopardy
              </Button>
              {allRegularUsed && <Badge className="bg-green-700">All regular clues completed</Badge>}
            </div>
          </div>

          <div className="space-y-4">
            <Tabs defaultValue="scores" className="w-full">
              <TabsList className="grid grid-cols-2 w-full">
                <TabsTrigger value="scores">Scores</TabsTrigger>
                <TabsTrigger value="host">Host Notes</TabsTrigger>
              </TabsList>
            </Tabs>

            <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-1 gap-3">
              {teams.map((team) => (
                <ScoreControls
                  key={team.id}
                  team={team}
                  onRename={handleRename}
                  onAdd={handleAdd}
                  onSubtract={handleSubtract}
                />
              ))}
            </div>

            <Card className="rounded-2xl shadow-sm border-blue-200">
              <CardHeader>
                <CardTitle className="text-lg">Host reminders</CardTitle>
              </CardHeader>
              <CardContent className="text-sm text-slate-700 space-y-2">
                <p>Require teams to explain why their answer fits to earn full points.</p>
                <p>Use the clue explanation as your quick teaching point after each reveal.</p>
                <p>You can subtract points manually for incorrect buzz-ins, just like JeopardyLabs.</p>
              </CardContent>
            </Card>
          </div>
        </div>
      </div>

      <Dialog open={!!selected} onOpenChange={(open) => !open && setSelected(null)}>
        <DialogContent className="max-w-5xl rounded-3xl p-0 overflow-hidden">
          {selected && (
            <div className="bg-blue-950 text-white min-h-[70vh] flex flex-col">
              <DialogHeader className="px-6 py-4 border-b border-blue-800">
                <DialogTitle className="text-2xl md:text-3xl font-bold text-center">{selected.isFinal ? `Final Jeopardy — ${selected.category}` : `${selected.category} — $${selected.clue.value}`}</DialogTitle>
              </DialogHeader>
              <div className="flex-1 flex items-center justify-center p-8 md:p-12 text-center">
                <ScrollArea className="max-h-[48vh] w-full">
                  <div className="text-2xl md:text-4xl font-semibold leading-relaxed px-4">
                    {selected.clue.clue}
                  </div>
                </ScrollArea>
              </div>
              <div className="border-t border-blue-800 p-5 space-y-4 bg-blue-900/50">
                <div className="flex flex-wrap gap-2 justify-center">
                  <Button onClick={() => setShowAnswer((s) => !s)} className="bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold">
                    {showAnswer ? <EyeOff className="w-4 h-4 mr-2" /> : <Eye className="w-4 h-4 mr-2" />}
                    {showAnswer ? "Hide Answer" : "Reveal Answer"}
                  </Button>
                  {!selected.isFinal && (
                    <Button variant="secondary" onClick={markUsed}>
                      Mark Used
                    </Button>
                  )}
                  <Button variant="outline" className="bg-transparent text-white border-white hover:bg-white hover:text-slate-900" onClick={() => setSelected(null)}>
                    Close
                  </Button>
                </div>
                {showAnswer && (
                  <Card className="rounded-2xl border-amber-300 bg-white text-slate-900 max-w-4xl mx-auto">
                    <CardHeader>
                      <CardTitle className="text-xl">Answer</CardTitle>
                    </CardHeader>
                    <CardContent className="space-y-3 text-base md:text-lg">
                      <p><span className="font-bold">Correct response:</span> {selected.clue.answer}</p>
                      <Separator />
                      <p><span className="font-bold">Why it fits:</span> {selected.clue.explanation}</p>
                    </CardContent>
                  </Card>
                )}
              </div>
            </div>
          )}
        </DialogContent>
      </Dialog>
    </div>
  );
}
