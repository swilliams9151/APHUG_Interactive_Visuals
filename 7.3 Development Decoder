<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Development Decoder: APHG Topic 7.3</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Nunito:wght@700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .title-font { font-family: 'Nunito', sans-serif; }
        
        /* Smooth Transitions */
        .metric-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; }
        .metric-card:hover { transform: translateY(-4px); box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1); }
        
        /* Active States */
        .active-eco { border-color: #10b981; background-color: #ecfdf5; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.3); }
        .active-soc { border-color: #f43f5e; background-color: #fff1f2; box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.3); }
        .active-both { border-color: #8b5cf6; background-color: #f5f3ff; box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.3); }

        /* Fade Animation for content */
        .fade-in { animation: fadeIn 0.4s ease-in-out forwards; }
        @keyframes fadeIn {
            0% { opacity: 0; transform: translateY(10px); }
            100% { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col items-center py-10 px-4">

    <!-- Header -->
    <header class="max-w-5xl w-full text-center mb-10">
        <h1 class="text-4xl md:text-5xl font-extrabold title-font text-slate-900 tracking-tight mb-3">The Development Decoder</h1>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
            Untangling the alphabet soup of Unit 7. Click a measure below to discover if it tracks money, people, or both!
        </p>
    </header>

    <!-- Main Container -->
    <main class="max-w-5xl w-full grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left Side: The Selector Cards -->
        <div class="lg:col-span-5 space-y-4">
            
            <!-- Legend / Key -->
            <div class="flex justify-between items-center bg-white p-3 rounded-xl shadow-sm border border-slate-200 mb-6 text-xs font-bold uppercase tracking-wider">
                <div class="flex items-center text-emerald-600"><span class="w-3 h-3 rounded-full bg-emerald-500 mr-2"></span> Economic</div>
                <div class="flex items-center text-rose-500"><span class="w-3 h-3 rounded-full bg-rose-500 mr-2"></span> Social</div>
                <div class="flex items-center text-violet-600"><span class="w-3 h-3 rounded-full bg-violet-500 mr-2"></span> Both</div>
            </div>

            <!-- GDP Card -->
            <div onclick="selectMetric('gdp')" id="card-gdp" class="metric-card bg-white border-2 border-slate-200 rounded-xl p-4 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center text-2xl text-emerald-600">💵</div>
                <div>
                    <h2 class="font-bold text-xl text-slate-800">GDP</h2>
                    <p class="text-xs text-slate-500 uppercase tracking-wide">Gross Domestic Product</p>
                </div>
            </div>

            <!-- GNP Card -->
            <div onclick="selectMetric('gnp')" id="card-gnp" class="metric-card bg-white border-2 border-slate-200 rounded-xl p-4 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center text-2xl text-emerald-600">🏭</div>
                <div>
                    <h2 class="font-bold text-xl text-slate-800">GNP</h2>
                    <p class="text-xs text-slate-500 uppercase tracking-wide">Gross National Product</p>
                </div>
            </div>

            <!-- GNI Card -->
            <div onclick="selectMetric('gni')" id="card-gni" class="metric-card bg-white border-2 border-slate-200 rounded-xl p-4 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center text-2xl text-emerald-600">💳</div>
                <div>
                    <h2 class="font-bold text-xl text-slate-800">GNI (per capita)</h2>
                    <p class="text-xs text-slate-500 uppercase tracking-wide">Gross National Income</p>
                </div>
            </div>

            <!-- GII Card -->
            <div onclick="selectMetric('gii')" id="card-gii" class="metric-card bg-white border-2 border-slate-200 rounded-xl p-4 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-rose-100 flex items-center justify-center text-2xl text-rose-500">⚖️</div>
                <div>
                    <h2 class="font-bold text-xl text-slate-800">GII</h2>
                    <p class="text-xs text-slate-500 uppercase tracking-wide">Gender Inequality Index</p>
                </div>
            </div>

            <!-- HDI Card -->
            <div onclick="selectMetric('hdi')" id="card-hdi" class="metric-card bg-white border-2 border-slate-200 rounded-xl p-4 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-violet-100 flex items-center justify-center text-2xl text-violet-500">🏆</div>
                <div>
                    <h2 class="font-bold text-xl text-slate-800">HDI</h2>
                    <p class="text-xs text-slate-500 uppercase tracking-wide">Human Development Index</p>
                </div>
            </div>

        </div>

        <!-- Right Side: The Explanation Display -->
        <div class="lg:col-span-7">
            <div id="display-panel" class="bg-white rounded-3xl shadow-xl border border-slate-200 h-full p-8 relative overflow-hidden flex flex-col justify-center min-h-[500px]">
                
                <!-- Placeholder State -->
                <div id="placeholder-state" class="text-center">
                    <div class="text-6xl mb-4 opacity-50">🧭</div>
                    <h3 class="text-2xl font-bold text-slate-400 mb-2">Select a measure</h3>
                    <p class="text-slate-500">Click a card on the left to decode what it means, how it works, and why we use it.</p>
                </div>

                <!-- Content State (Hidden initially) -->
                <div id="content-state" class="hidden h-full flex flex-col">
                    
                    <!-- Header -->
                    <div class="flex items-start justify-between mb-6">
                        <div>
                            <div id="disp-category" class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3">
                                Category
                            </div>
                            <h2 id="disp-title" class="text-4xl font-extrabold text-slate-900 mb-1">Title</h2>
                            <p id="disp-subtitle" class="text-sm font-medium text-slate-500 uppercase tracking-wide">Subtitle</p>
                        </div>
                        <div id="disp-icon" class="text-5xl bg-slate-50 p-4 rounded-2xl shadow-inner border border-slate-100">
                            🌍
                        </div>
                    </div>

                    <!-- Textbook Definition -->
                    <div class="bg-slate-50 p-5 rounded-xl border-l-4 border-slate-300 mb-6">
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">The Textbook Definition</h4>
                        <p id="disp-textbook" class="text-slate-700 text-sm leading-relaxed">
                            Textbook text goes here.
                        </p>
                    </div>

                    <!-- Real-World Breakdown -->
                    <div class="flex-1 bg-white border-2 border-dashed border-slate-200 rounded-2xl p-6 relative">
                        <div class="absolute -top-3 left-6 bg-white px-2">
                            <span class="bg-slate-800 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest shadow-sm">Real-World Breakdown</span>
                        </div>
                        
                        <h3 id="disp-analogy-title" class="text-xl font-bold text-slate-800 mt-2 mb-3">Analogy Title</h3>
                        <p id="disp-analogy" class="text-slate-600 leading-relaxed">
                            Real world analogy goes here.
                        </p>

                        <!-- Example Box -->
                        <div class="mt-6 p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-4">
                            <div class="text-2xl mt-1">💡</div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-800 mb-1">Real-World Example:</h4>
                                <p id="disp-example" class="text-sm text-slate-600">
                                    Example text.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </main>

    <script>
        // --- DATA BANK ---
        const metricsData = {
            'gdp': {
                title: "GDP",
                subtitle: "Gross Domestic Product",
                type: "economic",
                categoryClass: "bg-emerald-100 text-emerald-800",
                categoryText: "Economic Measure (The Money)",
                icon: "💵",
                textbook: "The total value of all goods and services produced within a country's physical borders in a given year, regardless of who owns the companies.",
                analogyTitle: "The 'House Chores' Rule (WHERE it happens)",
                analogy: "Think of your house. GDP counts all the money made from chores done <strong>inside your house</strong>. If you mow your lawn, it counts. If your neighbor comes over and mows your lawn, it <em>still</em> counts towards your house's GDP because the work happened inside your fence.",
                example: "A Japanese company (Toyota) builds cars in a factory in Texas. Because the factory is physically on U.S. soil, the value of those cars adds to the <strong>United States GDP</strong>."
            },
            'gnp': {
                title: "GNP",
                subtitle: "Gross National Product",
                type: "economic",
                categoryClass: "bg-emerald-100 text-emerald-800",
                categoryText: "Economic Measure (The Money)",
                icon: "🏭",
                textbook: "The total value of all goods and services produced by a country's citizens and domestic corporations, regardless of where in the world they are located.",
                analogyTitle: "The 'Family Member' Rule (WHO is doing it)",
                analogy: "Think of your family. GNP counts money earned by <strong>your family members</strong>, no matter where they are. If you mow your own lawn, it counts. If you go three streets over and mow someone else's lawn for money, it <em>still</em> counts towards your family's GNP because YOU belong to the family.",
                example: "An American company (Ford) builds a factory in Mexico. Even though the cars are made in Mexico, the profits belong to an American company, so it counts towards the <strong>United States GNP</strong>."
            },
            'gni': {
                title: "GNI per capita",
                subtitle: "Gross National Income (Divided by Population)",
                type: "economic",
                categoryClass: "bg-emerald-100 text-emerald-800",
                categoryText: "Economic Measure (The Money)",
                icon: "💳",
                textbook: "The total income earned by a nation's people and businesses (GNI), divided by the total population. It measures the average wealth of a citizen.",
                analogyTitle: "The 'Allowance' Average",
                analogy: "GNI is basically GNP, just focusing on income instead of production. But the magic word is <strong>per capita</strong> (per person). Imagine putting all the money your entire family earns into one big pile, and then dividing it equally among everyone. It gives you the 'average' wealth.",
                example: "If a tiny country makes $10 million and has 10 citizens, their GNI per capita is $1 million each (Very Rich!). If a country makes $10 million but has 10,000 citizens, their GNI per capita is only $1,000 (Very Poor!)."
            },
            'gii': {
                title: "GII",
                subtitle: "Gender Inequality Index",
                type: "social",
                categoryClass: "bg-rose-100 text-rose-800",
                categoryText: "Social Measure (The People)",
                icon: "⚖️",
                textbook: "A metric that measures the loss of achievement within a country due to gender disparity. It evaluates reproductive health, empowerment (political seats, education), and labor market participation.",
                analogyTitle: "The 'Fairness Ruler'",
                analogy: "This measures how high the hurdles are for women compared to men in a country. Are women serving in the government? Are girls finishing high school? Are mothers surviving childbirth? <br><br><span class='text-rose-600 font-bold'>Crucial Note:</span> For GII, a score of 0 is perfect equality. You want this number to be as LOW as possible!",
                example: "Switzerland has a GII near 0.018 (Very Low/Good) because women are heavily involved in the workforce and politics. Yemen has a GII near 0.800 (Very High/Bad) due to restricted educational and job opportunities for women."
            },
            'hdi': {
                title: "HDI",
                subtitle: "Human Development Index",
                type: "both",
                categoryClass: "bg-violet-100 text-violet-800",
                categoryText: "Composite Measure (Money + People)",
                icon: "🏆",
                textbook: "A summary measure of average achievement in key dimensions of human development: a long and healthy life, being knowledgeable, and have a decent standard of living.",
                analogyTitle: "The 'Ultimate Report Card'",
                analogy: "The United Nations realized that just having money (GDP) doesn't mean your citizens have good lives. So, they created HDI, which combines three grades into one final score (0.0 to 1.0):<br>1. <strong>Wealth</strong> (GNI per capita)<br>2. <strong>Health</strong> (Life Expectancy)<br>3. <strong>Education</strong> (Years of Schooling).",
                example: "A country might have a high GDP from selling oil, but if they don't use that money to build schools and hospitals, their HDI score will be low. Norway scores a 0.96 (A+), while Niger scores around 0.400 (F)."
            }
        };

        // --- APP LOGIC ---
        function selectMetric(id) {
            // 1. Reset all cards
            const cards = ['gdp', 'gnp', 'gni', 'gii', 'hdi'];
            cards.forEach(c => {
                const el = document.getElementById(`card-${c}`);
                el.classList.remove('active-eco', 'active-soc', 'active-both');
            });

            // 2. Set active state on clicked card based on type
            const data = metricsData[id];
            const activeCard = document.getElementById(`card-${id}`);
            
            if (data.type === 'economic') activeCard.classList.add('active-eco');
            else if (data.type === 'social') activeCard.classList.add('active-soc');
            else activeCard.classList.add('active-both');

            // 3. Hide Placeholder, Show Content
            document.getElementById('placeholder-state').classList.add('hidden');
            const contentPanel = document.getElementById('content-state');
            
            // Trigger animation trick
            contentPanel.classList.remove('fade-in');
            void contentPanel.offsetWidth; // Trigger reflow
            contentPanel.classList.add('fade-in');
            contentPanel.classList.remove('hidden');

            // 4. Inject Data
            document.getElementById('disp-title').innerText = data.title;
            document.getElementById('disp-subtitle').innerText = data.subtitle;
            document.getElementById('disp-icon').innerText = data.icon;
            
            const catBadge = document.getElementById('disp-category');
            catBadge.className = `inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3 ${data.categoryClass}`;
            catBadge.innerText = data.categoryText;

            // Change border color of textbook definition based on type
            const textbookBox = document.getElementById('disp-textbook').parentElement;
            textbookBox.className = `bg-slate-50 p-5 rounded-xl border-l-4 mb-6 ${
                data.type === 'economic' ? 'border-emerald-400' : 
                data.type === 'social' ? 'border-rose-400' : 'border-violet-400'
            }`;

            document.getElementById('disp-textbook').innerText = data.textbook;
            document.getElementById('disp-analogy-title').innerText = data.analogyTitle;
            document.getElementById('disp-analogy').innerHTML = data.analogy;
            document.getElementById('disp-example').innerHTML = data.example;
        }

    </script>
</body>
</html>
